# Copy to edgeinfer.env and edit paths for your machine.

EDGEINFER_QWEN3_1_7B=models/qwen3-1.7b
EDGEINFER_QWEN3_8B=models/qwen3-8b
EDGEINFER_PROMPTS=eval/prompts/required_prompts.jsonl
EDGEINFER_OUTPUT_DIR=outputs/required

EDGEINFER_CORRECTNESS_PROMPT="Explain why layer-wise offloading can reduce GPU memory pressure in one short paragraph."
EDGEINFER_CORRECTNESS_MAX_NEW_TOKENS=16
EDGEINFER_CORRECTNESS_DEVICE=cuda
EDGEINFER_CORRECTNESS_DTYPE=float16
EDGEINFER_CORRECTNESS_ABS_TOL=1e-2
EDGEINFER_CORRECTNESS_REL_TOL=1e-2

EDGEINFER_BASELINE_MAX_NEW_TOKENS=256
EDGEINFER_8B_MAX_NEW_TOKENS=256
EDGEINFER_GPU_LAYER_BUDGET=4
EDGEINFER_VLLM_CPU_OFFLOAD_GB=24
EDGEINFER_BUDGET_SCAN_VALUES="1 2 4 8 16"

EDGEINFER_PROFILE_PROMPT="Explain in two short sentences why overlapping H2D copies with compute can reduce visible offload stall."
EDGEINFER_PROFILE_MAX_NEW_TOKENS=8
EDGEINFER_PROFILE_GPU_LAYER_BUDGET=2
